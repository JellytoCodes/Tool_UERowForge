* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.h text eol=lf
*.cpp text eol=lf
# Preserve shipped batch files byte-for-byte (already CRLF).
*.bat -text whitespace=cr-at-eol
*.ps1 text eol=crlf
*.png binary
*.xlsx binary


# Sample source and generated manifests must stay byte-stable on Windows clones.
*.cs text eol=lf
*.ini text eol=lf
*.uproject text eol=lf
*.uasset binary
*.umap binary

# Preserve historical fixture bytes: ownership hashes depend on them.
Tool/tests/fixtures/** -text
